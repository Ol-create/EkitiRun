DATABASE_URL=postgresql+asyncpg://ekitirun:ekitirun@db:5432/ekitirun
REDIS_URL=redis://redis:6379/0
# Secrets: these development values are fine locally. Production needs 32+ random
# characters each (python -c "import secrets; print(secrets.token_urlsafe(48))").
JWT_SECRET=dev-only-jwt-secret-at-least-32-characters
QR_SIGNING_SECRET=dev-only-qr-secret-at-least-32-characters
PAYSTACK_SECRET_KEY=sk_test_xxx
# SMS: "console" prints codes to the API log; production uses "termii".
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=EkitiRun
# Development only: every OTP is this code. Leave empty for random codes (shown in the API log).
OTP_DEV_CODE=123456
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
# Shared secret the GPS gateway (Traccar) sends in X-Gateway-Secret.
GATEWAY_SECRET=dev-only-gateway-secret-32-characters
# Development-only admin token (Authorization: Bearer dev-admin) until admin login exists. Ignored in production.
ADMIN_DEV_TOKEN=dev-admin
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:3000
